# Copy to .env and fill in. Never commit .env.
MEDISPHERE_SECRET=change-me-to-a-long-random-string          # signs session tokens (required in production)
MEDISPHERE_FIELD_KEY=                                         # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MEDISPHERE_SEED_PASSWORD=                                     # optional; if empty a random first-run password is printed once
MEDISPHERE_DATA_DIR=/data                                     # database + cached files (mount a persistent volume)
MEDISPHERE_TOKEN_TTL=28800
MEDISPHERE_DOCS=0                                             # 1 exposes /docs (turn off in production)
MEDISPHERE_CORS=                                              # comma-separated origins, only if the UI is hosted elsewhere
LLM_PROVIDER=auto                                             # auto | offline | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
